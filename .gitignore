# Build output
dist/
*.tsbuildinfo

# Dependencies
node_modules/
# Only needed by the local visual-testing scripts under scripts/, which are
# themselves ignored below. Keeping it out of the manifest means a clone of
# this repo does not pull a browser binary it has no way to run.
playwright/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Local env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Local visual-testing helpers. These are the maintainer's own capture and
# assertion scripts, not part of the library or the site — they exist to check
# renders on one machine and would just be dead weight in the repo.
scripts/
